@startuml Person Domain Class Diagram
title UML Диаграмма классов предметной области PersonService

' Сущность Person - основной агрегат
class Person {
    +Guid Id
    +string FirstName
    +string MiddleName
    +string LastName
    +string SocialLink
    +DateTime CreatedAt
    +DateTime UpdatedAt
}

' Валидация свойств Person
note right of Person
  **Правила валидации:**
  - FirstName: обязательное, макс. 50 символов
  - LastName: обязательное, макс. 50 символов
  - MiddleName: опциональное, макс. 50 символов
  - SocialLink: опциональное, макс. 255 символов
end note

' Интерфейсы репозитория (прикладной слой)
interface IPersonRepository {
    +Task<Person?> GetByIdAsync(Guid id)
    +Task<IEnumerable<Person>> GetAllAsync()
    +Task<Person> CreateAsync(Person person)
    +Task<Person> UpdateAsync(Person person)
    +Task<bool> DeleteAsync(Guid id)
    +Task<bool> ExistsAsync(Guid id)
}

' DTO для API (прикладной слой)
class PersonDto {
    +Guid Id
    +string FirstName
    +string MiddleName
    +string LastName
    +string SocialLink
}

class CreatePersonDto {
    +string FirstName
    +string MiddleName
    +string LastName
    +string SocialLink
}

class UpdatePersonDto {
    +string FirstName
    +string MiddleName
    +string LastName
    +string SocialLink
}

' Сервис прикладного слоя
class PersonAppService {
    +IPersonRepository Repository
    +Task<PersonDto> GetPersonAsync(Guid id)
    +Task<IEnumerable<PersonDto>> GetAllPersonsAsync()
    +Task<PersonDto> CreatePersonAsync(CreatePersonDto dto)
    +Task<PersonDto> UpdatePersonAsync(Guid id, UpdatePersonDto dto)
    +Task<bool> DeletePersonAsync(Guid id)
}

' Отношения
IPersonRepository ..|> Person : хранит
PersonAppService --> IPersonRepository : использует
PersonAppService ..> PersonDto : возвращает
PersonAppService ..> CreatePersonDto : принимает
PersonAppService ..> UpdatePersonDto : принимает
Person ..> PersonDto : маппируется

' Стилизация
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

skinparam note {
    BackgroundColor #FFFFE0
    BorderColor #FFD700
}

@enduml
