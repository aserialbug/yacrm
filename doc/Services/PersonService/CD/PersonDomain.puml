@startuml Person Domain Layer
title PersonService.Domain - Доменный слой (ADR 004, PR 001)

' ============================================
' ДОМЕННЫЙ СЛОЙ (PersonService.Domain)
' Не зависит от других слоёв
' ============================================

' Базовый абстрактный класс для идентификаторов сущностей
abstract class EntityId <<ValueObject>> {
    -_value: Guid

    #EntityId(value: Guid)
    +override Equals(obj: Object): bool
    +override GetHashCode(): int
}

note right of EntityId
  **Базовый класс идентификатора:**
  - Абстрактный класс для всех ID сущностей
  - Protected конструктор
  - Валидирует: не пустой GUID
end note

class PersonId <<ValueObject>> {
    -PersonId(value: Guid)
    +{static} Create(value: Guid): PersonId
    +{static} New(): PersonId
}

EntityId <|-- PersonId : наследуется

abstract class Entity<TId> <<Entity>> {
    #Id: TId
    #CreatedAt: DateTime
    #UpdatedAt: DateTime
    #Entity(id: TId)
}

class Person <<Entity<PersonId>> {
    +FirstName: FirstName
    +MiddleName: MiddleName
    +LastName: LastName
    +SocialLink: SocialLink
    +Email: Email
    +Phone: Phone
  
   -Person()
    +{static} Create(\n\tfirstName: FirstName,\n\tmiddleName: MiddleName,\n\tlastName: LastName,\n\tphone: Phone,\n\temail: Email,\n\tsocialLink: SocialLink): Person
    +override Equals(obj: Object): bool
    +override GetHashCode(): int
}

Entity <|-- Person : наследуется


note right of Person
  **Сущность (Entity):**
  - Уникальный идентификатор (PersonId)
  - Protected конструктор
  - Фабричный метод Create() генерирует Id и заполняет CreatedAt/UpdatedAt
  - Наследуется от обобщенного Entity&lt;TId&gt;
  - Содержит: FirstName, MiddleName, LastName, Phone, Email, SocialLink
end note

' Объекты-значения (Value Objects) для имени
class FirstName <<ValueObject>> {
    -_value: string

    -FirstName(value: string)
    +{static} Create(value string): FirstName
    +override Equals(obj: Object): bool
    +override GetHashCode(): int
}

class MiddleName <<ValueObject>> {
    -_value: string

    -MiddleName(value: string)
    +{static} Create(value: string): MiddleName
    +override Equals(obj: Object): bool
    +override GetHashCode(): int
}

class LastName <<ValueObject>> {
    -_value: string

    -LastName(value: string)
    +{static} Create(value: string): LastName
    +override Equals(obj: Object): bool
    +override GetHashCode(): int
}

' Объекты-значения для контактов
class SocialLink <<ValueObject>> {
    -_value: string

    -SocialLink(value: string)
    +{static} Create(value: string): SocialLink
    +override Equals(obj: Object): bool
    +override GetHashCode(): int
}

class Email <<ValueObject>> {
    -_value: string

    -Email(value: string)
    +{static} Create(value: string): Email
    +override Equals(obj: Object): bool
    +override GetHashCode(): int
